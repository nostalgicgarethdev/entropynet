{
 "buildCommand": "",
 "outputDirectory": "site",
 "rewrites": [
  {
   "source": "/api/round/:n",
   "destination": "/api/round?n=:n"
  },
  {
   "source": "/api/launch/:id",
   "destination": "/api/launch?id=:id"
  },
  {
   "source": "/api/tamper/:id",
   "destination": "/api/tamper?id=:id"
  },
  {
   "source": "/api/seal/:id",
   "destination": "/api/seal?id=:id"
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    }
   ]
  },
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    },
    {
     "key": "Service-Worker-Allowed",
     "value": "/"
    }
   ]
  },
  {
   "source": "/seal/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  }
 ],
 "functions": {
  "api/*.js": {
   "maxDuration": 30
  }
 }
}