# ed25519 beacon signing key, PKCS8 DER, base64. Server-side only.
ENTROPY_BEACON_KEY=
# 32-byte hex master secret for the simulated nodes. Server-side only.
ENTROPY_NODE_MASTER=
# Solana RPC URL (falls back to the public mainnet RPC)
SOLANA_RPC=
# Vercel Blob token (set automatically when a Blob store is connected)
BLOB_READ_WRITE_TOKEN=
# Real on-chain pump.fun launching. Keep false.
ENTROPY_LAUNCHES_LIVE=false
